# SignSync Chrome Extension Environment Variables
#
# NOTE: SignSync currently runs entirely without a backend -- these variables
# are not read anywhere in extension/src (verified by repo-wide search for
# `import.meta.env`). They're kept here only because the original project
# scope allowed for an OPTIONAL backend/Firebase integration (see
# docs/decisions/002-local-first-storage.md and docs/technical-specification.md's
# Backend/Firebase sections). You do not need to fill these in to build or
# run the extension.

# Backend API URL (unused -- reserved for an optional future backend)
VITE_API_URL=http://localhost:8000

# Firebase configuration (unused -- reserved for optional cloud sync)
VITE_FIREBASE_API_KEY=your_firebase_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_firebase_auth_domain_here
VITE_FIREBASE_PROJECT_ID=your_firebase_project_id_here
VITE_FIREBASE_STORAGE_BUCKET=your_firebase_storage_bucket_here
VITE_FIREBASE_MESSAGING_SENDER_ID=your_firebase_messaging_sender_id_here
VITE_FIREBASE_APP_ID=your_firebase_app_id_here
